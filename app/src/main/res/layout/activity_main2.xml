<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2">

    <TextView
        android:id="@+id/textView3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BOTÃO SWITCH"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Switch
        android:id="@+id/switch1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="20sp"
        android:text="Switch"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BOTÃO TOGGLE"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ToggleButton
        android:id="@+id/toggleButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="ToggleButton"
        android:textOff="DESLIGADO"
        android:textOn="LIGADO" />

    <TextView
        android:id="@+id/txtResSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Estado Switch" />

    <TextView
        android:id="@+id/txtResToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Estado Toogle" />

    <Button
        android:id="@+id/btnVerificar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VERIFICAR" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clique para selecionar:"
        android:textSize="20sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/cbSelecionar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="Selecionar" />

    <TextView
        android:id="@+id/txtResCheckBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Seleção Checkbox" />
</LinearLayout>